{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./.regression-build",
    "rootDir": "./src",
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/features/pms/scheduling/cpmRegressionRunner.ts",
    "src/features/pms/scheduling/cpmScheduler.ts",
    "src/features/pms/scheduling/calendarEngine.ts",
    "src/features/pms/scheduling/relationshipEngine.ts",
    "src/features/pms/scheduling/scheduleTypes.ts"
  ]
}